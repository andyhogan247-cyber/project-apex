# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# xAI key for the committee (same key as Triple Seven / the stock desk is fine)
XAI_API_KEY=
GROK_MODEL=grok-4.3
SKEPTIC_MODEL=grok-4.3
# false = no veto (every signal approved) - for comparison only
COMMITTEE=true
# Telegram (https://my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
# Channel username(s) or numeric id(s), comma separated
TG_CHANNELS=
